<Project>
  <!-- Settings shared by every project under dotnet/. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>

    <Version>0.1.0</Version>
    <Authors>Ziorentia</Authors>
    <Company>Ziorentia</Company>
    <Product>Erdigo SDK</Product>
    <Copyright>Copyright (c) 2026 Ziorentia</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Ziorentia/Erdigo-sdk</RepositoryUrl>

    <!-- Every package version is pinned, and CI restores exactly what the lock files say. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>

    <!--
      Every package, including those that packages bring with them, is checked against nuget.org's list of known
      vulnerabilities when it is restored. A known vulnerability of any severity stops the restore, and so does a
      failure to fetch the list (NU1900, already an error through TreatWarningsAsErrors), so that nothing builds
      unchecked. See the README for what to do when one appears.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
