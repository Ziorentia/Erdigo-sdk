{
    "name": "ziorentia/erdigo-sdk",
    "description": "Write pins, markers, notes, photos and tracks to the Erdigo app on the same local network.",
    "type": "library",
    "license": "MIT",
    "keywords": ["erdigo", "map", "local network", "noise protocol"],
    "homepage": "https://github.com/Ziorentia/Erdigo-sdk",
    "support": {
        "issues": "https://github.com/Ziorentia/Erdigo-sdk/issues",
        "security": "https://github.com/Ziorentia/Erdigo-sdk/security/policy"
    },
    "require": {
        "php": ">=8.1",
        "ext-hash": "*",
        "ext-sodium": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.4"
    },
    "suggest": {
        "ext-sockets": "Finds receivers on the local network. Without it, give the receiver's address and port.",
        "ext-pcntl": "Puts the terminal back as it was if erdigo-send is interrupted while it reads a pairing code."
    },
    "autoload": {
        "psr-4": {
            "Erdigo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Erdigo\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/erdigo-send"],
    "config": {
        "sort-packages": true
    }
}
